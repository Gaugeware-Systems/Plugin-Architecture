{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ConfigureLinuxGccDebug",
      "displayName": "Linux GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/${hostSystemName}/install/${presetName}",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-gcc.cmake",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ConfigureLinuxGccRelease",
      "displayName": "Linux GCC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/${hostSystemName}/install/${presetName}",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-gcc.cmake",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "BuildLinuxGccDebug",
      "configurePreset": "ConfigureLinuxGccDebug"
    },
    {
      "name": "BuildLinuxGccRelease",
      "configurePreset": "ConfigureLinuxGccRelease"
    }
  ],
  "testPresets": [
    {
      "name": "TestLinuxGccDebug",
      "configurePreset": "ConfigureLinuxGccDebug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "TestLinuxGccRelease",
      "configurePreset": "ConfigureLinuxGccRelease",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "WorkflowLinuxGccDebug",
      "displayName": "Linux GCC Debug Pipeline",
      "steps": [
        {
          "type": "configure",
          "name": "ConfigureLinuxGccDebug"
        },
        {
          "type": "build",
          "name": "BuildLinuxGccDebug"
        },
        {
          "type": "test",
          "name": "TestLinuxGccDebug"
        }
      ]
    },
    {
      "name": "WorkflowLinuxGccRelease",
      "displayName": "Linux GCC Release Pipeline",
      "steps": [
        {
          "type": "configure",
          "name": "ConfigureLinuxGccRelease"
        },
        {
          "type": "build",
          "name": "BuildLinuxGccRelease"
        },
        {
          "type": "test",
          "name": "TestLinuxGccRelease"
        }
      ]
    }
  ]
}